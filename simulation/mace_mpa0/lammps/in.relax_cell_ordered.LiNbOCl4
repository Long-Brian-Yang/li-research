# MACE-MPA-0 variable-volume relaxation for LiNbOCl4.
# Cell shape is fixed; only isotropic volume is relaxed.
clear
units metal
atom_style atomic
boundary p p p
newton on
atom_modify map yes
read_data ${data}
mass 1 6.94
mass 2 92.90638
mass 3 16.00
mass 4 35.45
pair_style mace no_domain_decomposition
pair_coeff * * ${model} ${elements}
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
thermo 100
thermo_style custom step pe ke etotal press vol lx ly lz fnorm
thermo_modify flush yes
# FIRE cannot be combined with fix box/relax in this LAMMPS build.
# Use a robust steepest-descent preconditioner before conjugate gradients.
min_style sd
fix cell all box/relax iso 0.0 vmax 0.001
minimize 0.0 1.0e-3 500 3000
min_style cg
min_modify line quadratic
minimize 0.0 1.0e-6 10000 30000
unfix cell
write_data ${out_data}
write_dump all custom ${out_dump} id type x y z
