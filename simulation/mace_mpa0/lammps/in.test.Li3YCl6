# Provisional end-to-end test only; data came from a partial-occupancy CIF.
clear
units metal
atom_style atomic
boundary p p p
newton on
atom_modify map yes
read_data ${root}/Li3YCl6_provisional.data
mass 1 6.94
mass 2 88.90584
mass 3 35.45
pair_style mace no_domain_decomposition
pair_coeff * * ${model} Li Y Cl
delete_atoms overlap 0.8 all all
timestep 0.0001
thermo 100
thermo_style custom step temp pe ke etotal press vol
min_style cg
minimize 1.0e-4 1.0e-6 200 2000
velocity all create 300.0 73191 mom yes rot no dist gaussian
fix nvt all nvt temp 300.0 300.0 0.1
dump traj all custom 100 Li3YCl6_provisional.lammpstrj id type xu yu zu vx vy vz
run 200
write_data Li3YCl6_provisional_final.data
